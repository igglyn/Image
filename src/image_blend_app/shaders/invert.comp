// Placeholder Vulkan compute shader for RGB inversion.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform readonly image2D srcImage;
layout(binding = 1, rgba8) uniform writeonly image2D dstImage;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    vec4 c = imageLoad(srcImage, p);
    imageStore(dstImage, p, vec4(vec3(1.0) - c.rgb, c.a));
}
