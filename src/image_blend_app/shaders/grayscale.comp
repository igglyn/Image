// Placeholder Vulkan compute shader for grayscale conversion.
// Intended dispatch model: 16x16 local size over RGBA8 storage image.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform readonly image2D srcImage;
layout(binding = 1, rgba8) uniform writeonly image2D dstImage;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    vec4 c = imageLoad(srcImage, p);
    float g = dot(c.rgb, vec3(0.299, 0.587, 0.114));
    imageStore(dstImage, p, vec4(g, g, g, c.a));
}
